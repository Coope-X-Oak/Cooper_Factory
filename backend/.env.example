# Cooper Intelligence Factory - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ========================================
# AI ENGINE CONFIGURATION
# ========================================

# Choose your AI provider: "deepseek" or "gemini"
AI_PROVIDER=deepseek

# ========================================
# API KEYS
# ========================================

# DeepSeek API Configuration
# Get your API key from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# Gemini API Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=AIzaSy-your-gemini-api-key-here

# ========================================
# DEVELOPMENT NOTES
# ========================================

# 1. Never commit the actual .env file to git
# 2. Keep your API keys secure and don't share them
# 3. Test API connectivity before deployment
# 4. Use environment-specific configurations for production

# ========================================
# OPTIONAL CONFIGURATIONS
# ========================================

# Proxy settings (if needed)
# HTTP_PROXY=http://your-proxy:port
# HTTPS_PROXY=http://your-proxy:port

# Debug mode (set to 1 for verbose logging)
# DEBUG=0

# ========================================
# SECURITY REMINDERS
# ========================================

# 🔒 SECURITY CHECKLIST:
# [ ] API keys are not committed to git
# [ ] .env file is in .gitignore
# [ ] File permissions are restrictive
# [ ] No sensitive data in comments
